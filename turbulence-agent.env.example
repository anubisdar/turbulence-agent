# Copy to turbulence-agent.env and fill in what you have.
# The system runs with none of these: readings still resolve, with worse
# provenance and deterministic prose instead of model-written prose.

# FlightAware AeroAPI. Without it, corridors fall back to great circle
# only, which scores 0.25 on provenance against 1.00 for a flown track.
# Metered: roughly nine cents a search, dominated by one endpoint.
AEROAPI_KEY=

# Anthropic. Without it the explainer is skipped and the deterministic
# plain summary is shown, which is what a reader sees with the explainer
# toggle off anyway.
ANTHROPIC_API_KEY=

# Origin, destination and date are withheld from logs by default. On a
# quiet site a route plus a timestamp identifies a person.
TURBULENCE_LOG_TRIP_CONTENT=0

# Basic auth for the deployed instance, as user:password. Local runs do
# not need it.
TURBULENCE_AUTH=

# Cloudflare Turnstile, for the public deployment only. Fail-closed: if
# Cloudflare is unreachable, searches are refused rather than the control
# silently disappearing.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Lets operator scripts bypass the challenge. Must be long; an unset or
# short value disables the check rather than opening it.
TURNSTILE_OPERATOR_TOKEN=
